[Unit]
# openclaw-planes.service — start the SECONDARY OpenShell control planes
# (cecat :8090, luoji :8091) and their sandboxes after a host reboot.
#
# NOT ENABLED. Install with:
#     cp ops/openclaw-planes.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now openclaw-planes.service
# Lingering must be on; it is (loginctl show-user catlett -p Linger => Linger=yes).
#
# ── SCOPE / C-2 ─────────────────────────────────────────────────────────────
#
# This unit starts ONLY the :8090 and :8091 planes, by delegating to the script
# that already owns them. Gandalf's :8080 plane is untouched and is not
# referenced here. If Hermes is deleted tomorrow this unit is unaffected; if
# this unit is deleted, Hermes is unaffected. The one shared thing is the host
# systemd user manager, which is substrate.
#
# ── WHY After= IS NOT THE ORDERING MECHANISM (same trap as filespaces) ──────
#
# This is a USER unit. `After=docker.service` resolves in the *user* manager's
# namespace, where no such unit exists, and is silently ignored. Verified on
# this host, not assumed: the filespaces unit carries
# `After=network-online.target` and `systemctl --user show` reports
# LoadState=not-found for it. Believing that line would produce exactly the
# failure this unit exists to prevent.
#
# So the precondition is enforced by ExecStartPre, which BLOCKS until the Docker
# daemon answers. That is the only true precondition: agent-planes.sh starts a
# stopped sandbox container itself (`docker start`, never recreate), so the
# containers do NOT need to be running before this unit fires.
#
# ── Before=, AND WHY THERE IS NO Wants= ─────────────────────────────────────
#
# openclaw-filespaces.service is a user unit too, so ordering against it DOES
# work. Before= means the mounts unit's ExecStartPre finds both planes already
# listening and succeeds immediately, instead of polling 180s, failing, and
# coming back on the 60s backoff.
#
# Deliberately Before= and NOT Wants=/Requires=: if this unit fails, filespaces
# must still run and keep retrying. Its retry loop is the backstop that has to
# survive this unit being broken or removed.
Description=Start OpenClaw agent control planes (cecat :8090, luoji :8091)
Documentation=file:%h/code/Spark-Hermes/ops/agent-planes.sh
Before=openclaw-filespaces.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes

# ── KillMode=process IS LOAD-BEARING, NOT TIDINESS ──────────────────────────
#
# start_gateway() launches the gateway with `setsid ... &`. setsid detaches the
# session but NOT the cgroup, so the gateway lives in this unit's cgroup after
# ExecStart returns. Under the default KillMode=control-group, every stop —
# including the one systemd performs before each Restart=on-failure retry —
# would SIGTERM the gateways this unit just started.
#
# That turns the most common partial failure into a flap: cecat comes up, luoji
# does not, ExecStartPost fails, the retry kills cecat, and the cycle repeats
# forever. With KillMode=process the retry leaves cecat alone and
# agent-planes.sh reports "gateway :8090 already healthy" and works only on
# luoji. Partial progress is preserved across retries.
#
# CONSEQUENCE, stated plainly: `systemctl --user stop openclaw-planes.service`
# will NOT stop the planes. That is intended. Stopping is owned by
# `bash ops/agent-planes.sh stop`, which ~/shutdown.sh Group 0 already calls.
# There is deliberately no ExecStop= here — adding one would make a routine
# `systemctl --user restart` tear down two live agents.
KillMode=process

# ── SYSTEMD QUOTING (copied from the filespaces unit, same reasoning) ───────
# `$$` is an escaped literal `$`; `%%` an escaped literal `%`. Both fail
# SILENTLY if you get them wrong. No `%` construct is used below, on purpose.
# /dev/tcp rather than `ss` so the unit has no dependency on iproute2's path.

# Precondition: the Docker daemon answers. 120s ceiling; Restart=on-failure
# covers anything longer.
ExecStartPre=/bin/bash -c 'i=0; \
while [ "$$i" -lt 120 ]; do \
  docker ps --format "{{.Names}}" >/dev/null 2>&1 && exit 0; \
  i=$$(( i + 1 )); sleep 1; \
done; \
echo "docker daemon not answering after 120s" >&2; \
exit 1'

ExecStart=/bin/bash %h/code/Spark-Hermes/ops/agent-planes.sh start

# ── PROVE IT, OR FAIL LOUDLY ────────────────────────────────────────────────
#
# cmd_start() in agent-planes.sh ends every iteration with `continue` on a
# gateway failure and `start_sandbox ... || true` on a sandbox failure, so it
# ALWAYS exits 0 — including when both planes are dead. Without this block the
# unit would report success over a total outage and Restart=on-failure would
# never once fire. Same lesson, same shape, as the filespaces unit's post-check.
ExecStartPost=/bin/bash -c 'rc=0; \
check() { \
  if ! docker ps --format "{{.Names}}" | grep -q "^openshell-default--$$1-"; then \
    echo "FAIL $$1: sandbox container not running" >&2; return 1; fi; \
  if ! (exec 3<>/dev/tcp/127.0.0.1/$$2) 2>/dev/null; then \
    echo "FAIL $$1: nothing listening on :$$2" >&2; return 1; fi; \
  echo "OK   $$1: sandbox running, plane :$$2 listening"; return 0; }; \
check cecat 8090 || rc=1; \
check luoji 8091 || rc=1; \
exit $$rc'

Restart=on-failure
RestartSec=60

# Worst case: ExecStartPre 120s + two gateways at 40s + two sandboxes at 120s
# = ~440s. 600 leaves headroom without letting a wedge hang forever.
TimeoutStartSec=600

# StartLimitIntervalSec=0 (in [Unit]) disables the burst limiter on purpose: the
# default 5-starts-in-10s would give up permanently after ~5 minutes. A restore
# unit that stops trying is the silent outage this project keeps producing.

StandardOutput=append:%h/code/Spark-Hermes/runlog/openclaw-planes.log
StandardError=append:%h/code/Spark-Hermes/runlog/openclaw-planes.log

[Install]
WantedBy=default.target
