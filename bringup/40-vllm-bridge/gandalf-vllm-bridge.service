[Unit]
Description=Gandalf vLLM host bridge (socat 127.0.0.1:8000 -> vllm container, IP resolved at start)
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/catlett/code/Spark-Hermes/ops/vllm-bridge.sh 127.0.0.1 8000 vllm-qwen3-coder-next 8000
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
