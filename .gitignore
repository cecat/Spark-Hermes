# Secrets — should never enter the repo
.env
*.env
!bringup/secrets.example.env
*token*.json
*client_secret*.json
*.gog_pw

# Host-side deployment config (the operator's real values live at ~/.hermes/config.yaml).
# If someone copies it into the repo by mistake, ignore it.
/config.yaml
!bringup/config.example.yaml
!litellm/config.yaml         # LiteLLM proxy config IS in repo

# Logs
*.log

# Local scratch
.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc
*.swp
*~

# OS-level / large regenerable state (not in this dir anyway, but defensive)
node_modules/
.venv/
venv/
oauth-venv/

# NextDNS dashboard screenshots (contain profile id)
nextdns-screen*.png

# Host-specific Claude Code context (differs Mac vs Spark; intentionally untracked)
CLAUDE.md

# Session handoffs and planning docs — working notes, not published.
# This repo is public; these are verbose, quickly stale, and name internals.
# Durable conclusions belong in README.md / CLAUDE.md / docs/FOLLOWUPS.md or a
# dated runlog/ entry instead. DECISION-*.md records a settled choice and is
# also treated as a working note.
HANDOFF-*.md
docs/HANDOFF-*.md
docs/archive/HANDOFF-*.md
PLAN-*.md
docs/PLAN-*.md
docs/archive/PLAN-*.md
DECISION-*.md
docs/DECISION-*.md
